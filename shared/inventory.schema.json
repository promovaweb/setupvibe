{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://setupvibe.dev/schema/inventory-1.json",
  "title": "SetupVibe inventory",
  "description": "Official list of everything a SetupVibe 2 edition installs and manages. One file per edition: desktop/inventory.json and server/inventory.json.",
  "type": "object",
  "required": ["schemaVersion", "edition", "updated", "systems", "categories", "repositories", "profiles", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "edition": { "enum": ["desktop", "server"] },
    "updated": { "type": "string", "format": "date", "description": "Date of the last version review (YYYY-MM-DD)." },
    "systems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/system" },
      "description": "Systems this edition supports. Every item must resolve an install entry for each of them."
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/localized" } }
      }
    },
    "repositories": {
      "type": "object",
      "description": "Third-party package repositories, each pinned to the fingerprints of its signing keys.",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "url", "suite", "components", "key", "fingerprints", "systems"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "apt" },
          "url": { "type": "string" },
          "suite": { "type": "string" },
          "components": { "type": "array", "items": { "type": "string" } },
          "key": { "type": "string" },
          "fingerprints": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9A-F]{40}$" } },
          "systems": { "type": "array", "items": { "$ref": "#/$defs/system" } }
        }
      }
    },
    "profiles": {
      "type": "object",
      "required": ["essencial"],
      "additionalProperties": {
        "type": "object",
        "required": ["description", "items"],
        "additionalProperties": false,
        "properties": {
          "description": { "$ref": "#/$defs/localized" },
          "extends": { "type": "string" },
          "items": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
        }
      }
    },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "system": { "enum": ["ubuntu", "debian", "mint", "zorin", "arch", "omarchy", "macos", "windows", "wsl"] },
    "installKey": {
      "description": "Install entries are resolved from the most specific key to the most general: system, family (debian-family or arch-family), linux, unix, all.",
      "enum": ["ubuntu", "debian", "mint", "zorin", "arch", "omarchy", "macos", "windows", "wsl", "debian-family", "arch-family", "linux", "unix", "all"]
    },
    "localized": {
      "type": "object",
      "required": ["en", "pt-BR"],
      "additionalProperties": false,
      "properties": { "en": { "type": "string" }, "pt-BR": { "type": "string" } }
    },
    "stringOrList": {
      "oneOf": [{ "type": "string" }, { "type": "array", "minItems": 1, "items": { "type": "string" } }]
    },
    "install": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "enum": ["mise", "native", "brew", "winget", "installer", "archive", "git", "composer", "gem", "compose", "config", "preinstalled", "unsupported"] },
        "tool": { "type": "string", "description": "mise tool or backend:tool. {version} is replaced by the item version." },
        "packages": { "type": "array", "items": { "type": "string" } },
        "optional": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "repository": { "type": "string" },
        "formula": { "$ref": "#/$defs/stringOrList" },
        "cask": { "type": "string" },
        "id": { "$ref": "#/$defs/stringOrList" },
        "url": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "checksum": { "type": "string", "description": "A URL, or one of: release-sha256sums, manifest-sha512, authenticode, none-official." },
        "checksumAlgorithm": { "enum": ["sha256", "sha384", "sha512"] },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "sha256"],
            "additionalProperties": false,
            "properties": { "url": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        },
        "repo": { "type": "string" },
        "path": { "type": "string" },
        "package": { "type": "string" },
        "gem": { "type": "string" },
        "image": { "type": "string" },
        "port": { "type": "integer" },
        "action": { "type": "string" },
        "skipWhen": { "type": "string" },
        "flags": { "type": "array", "items": { "enum": ["gui", "service", "port"] } },
        "reason": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "name", "category", "description", "homepage", "version", "versionPolicy", "default", "install", "verify"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "category": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/localized" },
        "homepage": { "type": "string" },
        "version": { "type": "string" },
        "versionPolicy": {
          "description": "exact: pinned version. series: pinned major.minor from native packages. minimum: self-updating tool with a floor. commit: pinned Git commit. repository: latest from a pinned repository. distro: version shipped by the system. managed: the vendor installer decides. system: configuration, no version.",
          "enum": ["exact", "series", "minimum", "commit", "repository", "distro", "managed", "system"]
        },
        "default": { "type": "boolean", "description": "Selected by default in the TUI." },
        "initOnly": { "type": "boolean", "description": "Installed by init, not shown as a selectable item." },
        "securityModule": { "type": "boolean", "description": "Part of the shared security module." },
        "flags": { "type": "array", "uniqueItems": true, "items": { "enum": ["gui", "service", "port"] } },
        "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "plugins": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{40}$" } },
        "install": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/installKey" },
          "additionalProperties": { "$ref": "#/$defs/install" }
        },
        "verify": {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string" },
            "expect": { "type": "string", "description": "Text the output must contain, a regular expression starting with ^, or >=version for a minimum." }
          }
        }
      }
    }
  }
}
