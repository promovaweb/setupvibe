    {
      "id": "php-build-deps",
      "name": "PHP build dependencies",
      "category": "system",
      "description": {
        "en": "Libraries that mise needs to compile PHP and its extensions.",
        "pt-BR": "Bibliotecas de que o mise precisa para compilar o PHP e as extensões."
      },
      "homepage": "https://github.com/jdx/vfox-php",
      "version": "distro",
      "versionPolicy": "distro",
      "default": true,
      "requires": [
        "build-deps"
      ],
      "install": {
        "omarchy": {
          "method": "native",
          "packages": [
            "base-devel",
            "autoconf",
            "bison",
            "re2c",
            "pkgconf",
            "libxml2",
            "openssl",
            "icu",
            "libzip",
            "oniguruma",
            "curl",
            "libpng",
            "libjpeg-turbo",
            "freetype2",
            "libwebp",
            "gmp",
            "libsodium",
            "readline",
            "bzip2",
            "sqlite",
            "zlib",
            "postgresql-libs"
          ]
        }
      },
      "verify": {
        "command": "command -v re2c >/dev/null && { [ \"$(uname)\" = Darwin ] || pkg-config --exists libcurl oniguruma libzip icu-i18n libsodium; } && echo ok",
        "expect": "ok"
      }
    },
    {
      "id": "php",
      "name": "PHP",
      "category": "languages",
      "description": {
        "en": "PHP built by mise from the official source, with the extensions Laravel needs. Composer is a separate item.",
