  "items": [
    {
      "id": "build-deps",
      "name": "Build dependencies",
      "category": "system",
      "description": {
        "en": "Compilers and libraries that mise needs to build runtimes such as Ruby.",
        "pt-BR": "Compiladores e bibliotecas de que o mise precisa para compilar linguagens como o Ruby."
      },
      "homepage": "https://mise.jdx.dev/",
      "version": "distro",
      "versionPolicy": "distro",
      "default": true,
      "initOnly": true,
      "install": {
        "debian-family": {
          "method": "native",
          "packages": [
            "build-essential",
            "git",
            "curl",
            "wget",
            "unzip",
            "xz-utils",
            "file",
            "procps",
            "ca-certificates",
            "gnupg",
            "libssl-dev",
            "zlib1g-dev",
            "libbz2-dev",
            "libreadline-dev",
            "libsqlite3-dev",
            "libncurses-dev",
            "libffi-dev",
            "liblzma-dev",
            "libyaml-dev",
            "libxml2-dev",
            "libxmlsec1-dev",
            "tk-dev",
            "autoconf",
            "bison",
            "llvm"
          ]
        },
        "arch-family": {
          "method": "native",
          "packages": [
            "base-devel",
            "git",
            "curl",
            "wget",
            "unzip",
            "openssl",
            "zlib",
            "readline",
            "sqlite",
            "libyaml",
            "libffi",
            "tk"
          ]
        },
        "macos": {
          "method": "native",
          "packages": [
            "xcode-command-line-tools"
          ],
          "note": "Installed through softwareupdate, without the GUI dialog."
        },
        "windows": {
          "method": "winget",
          "id": "Git.Git"
        }
      },
      "verify": {
        "command": "git --version"
      }
    },
    {
      "id": "mise",
      "name": "mise",
      "category": "system",
      "description": {
        "en": "Runtime and tool manager that installs and pins most inventory items.",
        "pt-BR": "Gerenciador de linguagens e ferramentas que instala e fixa a maior parte do inventário."
      },
      "homepage": "https://mise.jdx.dev/",
      "version": "2026.11.6",
      "versionPolicy": "exact",
      "default": true,
      "initOnly": true,
      "install": {
        "all": {
          "method": "installer",
          "url": "https://github.com/jdx/mise/releases/download/v{version}/mise-v{version}-{os}-{arch}",
          "checksum": "release-sha256sums"
        },
        "omarchy": {
          "method": "preinstalled"
        }
      },
      "verify": {
        "command": "mise --version",
        "expect": "2026.11.6"
      }
    },
    {
      "id": "sshpass",
      "name": "sshpass",
      "category": "system",
      "description": {
        "en": "Non-interactive SSH password helper used by `setupvibe ssh copy-id`.",
        "pt-BR": "Auxiliar de senha SSH usado pelo `setupvibe ssh copy-id`."
      },
      "homepage": "https://sourceforge.net/projects/sshpass/",
      "version": "distro",
      "versionPolicy": "distro",
      "default": true,
      "install": {
        "debian-family": {
          "method": "native",
          "packages": [
            "sshpass"
          ]
        },
        "arch-family": {
          "method": "native",
          "packages": [
            "sshpass"
          ]
        },
        "macos": {
          "method": "brew",
          "formula": "sshpass"
        },
        "windows": {
          "method": "unsupported",
          "reason": "The Windows copy-id uses OpenSSH and PowerShell."
        }
      },
      "verify": {
        "command": "sshpass -V"
      }
    },
    {
      "id": "node",
      "name": "Node.js",
      "category": "languages",
      "description": {
        "en": "JavaScript runtime, LTS line.",
        "pt-BR": "Runtime JavaScript, linha LTS."
      },
      "homepage": "https://nodejs.org/",
      "version": "24.22.3",
      "versionPolicy": "exact",
      "default": true,
      "install": {
        "all": {
          "method": "mise",
          "tool": "node"
        },
        "omarchy": {
          "method": "mise",
          "tool": "node",
          "note": "Omarchy already manages Node with mise; SetupVibe only pins the version when it is missing."
        }
      },
      "verify": {
        "command": "node --version",
        "expect": "v24.22.3"
      }
    },
    {
      "id": "uv",
      "name": "uv",
      "category": "languages",
      "description": {
        "en": "Python package and tool manager. It downloads its own Python when needed.",
        "pt-BR": "Gerenciador de pacotes e ferramentas Python. Baixa o próprio Python quando precisa."
      },
      "homepage": "https://docs.astral.sh/uv/",
      "version": "0.13.7",
      "versionPolicy": "exact",
      "default": true,
      "install": {
        "all": {
          "method": "mise",
          "tool": "uv"
        }
      },
      "verify": {
        "command": "uv --version",
        "expect": "0.13.7"
      }
    },
    {
      "id": "bat",
      "name": "bat",
      "category": "terminal",
      "description": {
        "en": "cat with syntax highlighting.",
        "pt-BR": "cat com destaque de sintaxe."
      },
      "homepage": "https://github.com/sharkdp/bat",
      "version": "0.26.1",
      "versionPolicy": "exact",
      "default": true,
      "install": {
        "all": {
          "method": "mise",
          "tool": "bat"
        },
        "omarchy": {
          "method": "preinstalled"
        }
      },
      "verify": {
        "command": "bat --version",
        "expect": "0.26.1"
