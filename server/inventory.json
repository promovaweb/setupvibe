    {
      "id": "docker",
      "name": "Docker",
      "category": "devops",
      "flags": [
        "service"
      ],
      "description": {
        "en": "Docker Engine with Buildx and Compose; Docker Desktop on macOS.",
        "pt-BR": "Docker Engine com Buildx e Compose; Docker Desktop no macOS."
      },
      "homepage": "https://www.docker.com/",
      "version": "stable",
      "versionPolicy": "repository",
      "default": true,
      "install": {
        "debian-family": {
          "method": "native",
          "repository": "docker",
          "packages": [
            "docker-ce",
            "docker-ce-cli",
            "containerd.io",
            "docker-buildx-plugin",
            "docker-compose-plugin"
          ],
          "conflicts": [
            "docker.io",
            "docker-doc",
            "docker-compose",
            "docker-compose-v2",
            "podman-docker",
            "containerd",
            "runc"
          ]
        },
        "wsl": {
          "method": "native",
          "repository": "docker",
          "packages": [
            "docker-ce",
            "docker-ce-cli",
            "containerd.io",
            "docker-buildx-plugin",
            "docker-compose-plugin"
          ],
          "skipWhen": "docker-desktop-integration"
        },
        "arch": {
          "method": "native",
          "packages": [
            "docker",
            "docker-buildx",
            "docker-compose"
          ]
        },
        "omarchy": {
          "method": "preinstalled"
        },
        "macos": {
          "method": "brew",
          "cask": "docker-desktop",
          "flags": [
            "gui"
          ]
        },
        "windows": {
          "method": "unsupported",
          "reason": "Use Docker inside WSL or Docker Desktop installed by the user."
        }
      },
      "verify": {
        "command": "docker --version && { [ \"$(uname -s)\" = Darwin ] || systemctl is-active --quiet docker; }"
      }
    },
    {
      "id": "ansible",
      "name": "Ansible",
      "category": "devops",
      "description": {
        "en": "Automation and configuration management.",
        "pt-BR": "Automação e gerenciamento de configuração."
      },
      "homepage": "https://www.ansible.com/",
      "version": "14.6.0",
      "versionPolicy": "exact",
      "default": false,
      "requires": [
        "uv"
      ],
      "install": {
        "unix": {
          "method": "mise",
          "tool": "pipx:ansible"
        },
        "windows": {
          "method": "unsupported",
          "reason": "Ansible control nodes are not supported on Windows."
        }
      },
      "verify": {
        "command": "ansible --version"
      }
