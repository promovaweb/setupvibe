        },
        "omarchy": {
          "method": "unsupported",
          "reason": "Omarchy keeps Bash."
        },
        "windows": {
          "method": "unsupported",
          "reason": "The Windows shell stays original."
        }
      },
      "verify": {
        "command": "test -d ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions"
      }
    },
    {
      "id": "zsh-syntax-highlighting",
      "name": "zsh-syntax-highlighting",
      "category": "shell",
      "description": {
