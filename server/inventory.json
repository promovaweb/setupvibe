    {
      "id": "starship",
      "name": "Starship",
      "category": "shell",
      "description": {
        "en": "Cross-shell prompt, gruvbox-rainbow preset.",
        "pt-BR": "Prompt para qualquer shell, preset gruvbox-rainbow."
      },
      "homepage": "https://starship.rs/",
      "version": "1.27.0",
      "versionPolicy": "exact",
      "default": true,
      "install": {
        "unix": {
          "method": "mise",
          "tool": "starship"
        },
        "omarchy": {
          "method": "preinstalled",
          "note": "SetupVibe writes its own STARSHIP_CONFIG and keeps Omarchy's file."
        },
        "windows": {
          "method": "unsupported",
          "reason": "The Windows shell stays original."
        }
      },
      "verify": {
        "command": "starship --version",
        "expect": "1.27.0"
      }
    },
    {
      "id": "zsh",
      "name": "ZSH",
      "category": "shell",
      "description": {
        "en": "Default interactive shell, except on Omarchy (Bash) and Windows.",
        "pt-BR": "Shell interativo padrão, menos no Omarchy (Bash) e no Windows."
      },
      "homepage": "https://www.zsh.org/",
      "version": "distro",
      "versionPolicy": "distro",
      "default": true,
      "install": {
        "debian-family": {
          "method": "native",
          "packages": [
            "zsh"
          ]
        },
        "arch": {
          "method": "native",
          "packages": [
            "zsh"
          ]
        },
        "macos": {
          "method": "preinstalled"
        },
        "omarchy": {
          "method": "unsupported",
          "reason": "Omarchy keeps Bash."
        },
        "windows": {
          "method": "unsupported",
          "reason": "The Windows shell stays original."
        }
      },
      "verify": {
        "command": "zsh --version"
      }
    },
    {
      "id": "oh-my-zsh",
      "name": "Oh My Zsh",
      "category": "shell",
      "description": {
        "en": "ZSH framework, pinned to a commit.",
        "pt-BR": "Framework do ZSH, preso a um commit."
      },
      "homepage": "https://ohmyz.sh/",
      "version": "6010fb6260f359e71d99ba25f05f9215809b3ed2",
      "versionPolicy": "commit",
      "default": true,
      "requires": [
        "zsh"
      ],
      "install": {
        "debian-family": {
          "method": "git",
          "repo": "https://github.com/ohmyzsh/ohmyzsh",
          "path": "~/.oh-my-zsh"
        },
        "arch": {
          "method": "git",
          "repo": "https://github.com/ohmyzsh/ohmyzsh",
          "path": "~/.oh-my-zsh"
        },
        "macos": {
          "method": "git",
          "repo": "https://github.com/ohmyzsh/ohmyzsh",
          "path": "~/.oh-my-zsh"
        },
        "omarchy": {
          "method": "unsupported",
          "reason": "Omarchy keeps Bash."
        },
        "windows": {
          "method": "unsupported",
          "reason": "The Windows shell stays original."
        }
      },
      "verify": {
        "command": "test -d ~/.oh-my-zsh"
      }
    },
    {
      "id": "zsh-autosuggestions",
      "name": "zsh-autosuggestions",
